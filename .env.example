# PoolRaid development defaults. Copy this file to .env.local.
# Never commit private keys, keypair files, RPC credentials, or generated secrets.

DATABASE_URL=postgresql://poolraid:poolraid@localhost:5432/poolraid

# Devnet is the safe default. Mainnet requires an explicit value of mainnet-beta.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
SOLANA_COMMITMENT=finalized

# Development only: a JSON array or base58 secret. Production must use
# POOL_WALLET_KEYPAIR_FILE pointing to a secret mounted outside the repository.
POOL_WALLET_PRIVATE_KEY=
POOL_WALLET_KEYPAIR_FILE=

NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
MAINTENANCE_SECRET=replace-with-a-different-random-secret

ADMIN_WALLET=
ADMIN_PATH=admin
MAX_PAYOUT_LAMPORTS=50000000000
PAYOUT_RATE_LIMIT_PER_MIN=10
FLIP_ENABLED=true

# Docker entrypoint only. Leave false after the first explicit seed.
SEED_DATABASE=false
